{
    "name": "socialweb/http-message-signatures",
    "description": "",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "bakame/http-structured-fields": "^2.0",
        "psr/clock": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "captainhook/plugin-composer": "^5.3",
        "ergebnis/clock": "^2.13",
        "ergebnis/composer-normalize": "^2.54",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.35",
        "nyholm/psr7": "^1.8",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4",
        "ramsey/coding-standard": "^2.4",
        "ramsey/composer-repl": "^1.5",
        "ramsey/conventional-commits": "^1.7",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "SocialWeb\\Http\\MessageSignatures\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialWeb\\Test\\Http\\MessageSignatures\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "ramsey/composer-repl": true
        },
        "sort-packages": true
    },
    "extra": {
        "captainhook": {
            "force-install": true
        },
        "ramsey/conventional-commits": {
            "configFile": "conventional-commits.json"
        }
    },
    "scripts": {
        "coverage": [
            "git clean -fx build/coverage/.",
            "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html build/coverage/coverage-html",
            "open build/coverage/coverage-html/index.html"
        ],
        "coverage:ci": "XDEBUG_MODE=coverage phpunit --colors=always --testdox --coverage-text --coverage-clover build/coverage/clover.xml",
        "fix": [
            "@composer normalize",
            "vendor/bin/phpcbf --cache=build/phpcs-cache"
        ],
        "lint": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "vendor/bin/phpcs --colors --cache=build/phpcs-cache",
            "vendor/bin/phpstan analyze --ansi -v --memory-limit=1G"
        ],
        "mutation": "XDEBUG_MODE=coverage vendor/bin/infection --threads=max --min-msi=90 --min-covered-msi=95 --show-mutations",
        "test": "vendor/bin/phpunit --colors=always"
    }
}
